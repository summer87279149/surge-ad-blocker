#!name = App 去广告（GitHub 版）
#!desc = 广告 SDK 域名集中于 AppAdSDK；配合主配置提前静默丢弃，保留 App 响应过滤。
#!author = summer87279149
#!version = 2026.11.12.5

[Ruleset AppAdSDK]
# 已确认的广告专用域名；不包含共享业务网关。
