#!name = Bilibili Ad Blocker
#!desc = 仅过滤 B 站首页信息流中的广告卡片；不封锁游戏中心、推送或通用诊断服务。
#!author = Codex
#!version = 2026.10.23

[Script]
BiliFeedAdCleaner = type=http-response,requires-body=true,max-size=1048576,pattern=^https?:\/\/app\.bilibili\.com(?::443)?\/[^?]+\/feed\/index(?:\?|$),script-update-interval=86400,timeout=3,script-path=https://raw.githubusercontent.com/summer87279149/surge-ad-blocker/main/apps/bilibili/scripts/BiliFeedAdCleaner.js

[MITM]
hostname = %INSERT% app.bilibili.com
